# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# Nothing here is required for `python cli.py e2e --mode replay`, which must
# run with zero credentials (CLAUDE.md ground rule 4).

# --- GCP (required for --mode live and --mode hybrid) ---
PROJECT_ID=
REGION=

# --- Claude access path ---
# vertex    : Claude via Vertex AI Model Garden. Auth = GCP ADC, no API key.
#             Uses PROJECT_ID + REGION above. Recommended default: traffic
#             stays inside GCP (act1_build_plan.md §1).
# anthropic : direct Anthropic API. Requires ANTHROPIC_API_KEY below.
# replay    : no Claude calls at all; baseline is served from artifacts/replay/.
CLAUDE_PATH=replay

# Only used when CLAUDE_PATH=anthropic.
ANTHROPIC_API_KEY=

# --- optional ---
# Overrides the default customer profile (config/customers/<name>.yaml).
AMW_CUSTOMER=demo_patents
