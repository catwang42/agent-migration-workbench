# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# Nothing here is required for `python cli.py e2e --mode replay`, which must
# run with zero credentials (CLAUDE.md ground rule 4).

# --- GCP (required for --mode live and --mode hybrid) ---
PROJECT_ID=
REGION=

# Region for Claude on Vertex only. Leave blank to use REGION above.
# Set it when Model Garden quota for Claude is not available in REGION: quota
# is per-region AND per-base-model, so a project can serve Gemini fine in
# us-central1 while Claude there returns 429 and only `global` works. When the
# two differ the run is cross-region — a measurement caveat for the latency
# gate, which report footers print.
CLAUDE_REGION=

# --- Claude access path ---
# vertex    : Claude via Vertex AI Model Garden. Auth = GCP ADC, no API key.
#             Uses PROJECT_ID + CLAUDE_REGION (or REGION). Recommended default:
#             traffic stays inside GCP (act1_build_plan.md §1).
# anthropic : direct Anthropic API. Requires ANTHROPIC_API_KEY below.
# replay    : no Claude calls at all; baseline is served from artifacts/replay/.
CLAUDE_PATH=replay

# Only used when CLAUDE_PATH=anthropic.
ANTHROPIC_API_KEY=

# --- optional ---
# Overrides the default customer profile (config/customers/<name>.yaml).
AMW_CUSTOMER=demo_patents
