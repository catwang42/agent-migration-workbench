.venv/
__pycache__/
*.pyc
.env
.ipynb_checkpoints/
.pytest_cache/

# Run outputs are regenerated, with three exceptions that are not.
#
#   artifacts/replay/  the recorded trace corpus `cli.py e2e --mode replay`
#                      runs against. A corpus that exists on one laptop is not
#                      demo insurance, so it lives on the remote.
#   artifacts/results/ the phase/scorecard numbers a customer was shown. These
#                      are evidence of what was measured on a given date; a
#                      regenerated file is a different measurement.
#   artifacts/optimizer/ the instruction VAIPO actually returned, per run. The
#                      A4-optimizer rung cannot be re-derived without it: the
#                      rung is registered at run time (optimizer.py::
#                      installed_rung) and its staged prompt file is deleted on
#                      the way out, so this is the only copy of the prompt
#                      behind a published number. It is also the first thing a
#                      customer asks to read. Same rule as the judge prompts.
#
# artifacts/samples/ stays ignored — review scratch, superseded by the corpus.
artifacts/*
!artifacts/replay/
!artifacts/results/
!artifacts/optimizer/
