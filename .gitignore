.venv/
__pycache__/
*.pyc
.env
.ipynb_checkpoints/
.pytest_cache/

# Run outputs are regenerated, with five exceptions that are not.
#
#   artifacts/replay/  the recorded trace corpus `cli.py e2e --mode replay`
#                      runs against. A corpus that exists on one laptop is not
#                      demo insurance, so it lives on the remote.
#   artifacts/results/ the phase/scorecard numbers a customer was shown. These
#                      are evidence of what was measured on a given date; a
#                      regenerated file is a different measurement.
#   artifacts/optimizer/ the instruction VAIPO actually returned, per run. The
#                      A4-optimizer rung cannot be re-derived without it: the
#                      rung is registered at run time (optimizer.py::
#                      installed_rung) and its staged prompt file is deleted on
#                      the way out, so this is the only copy of the prompt
#                      behind a published number. It is also the first thing a
#                      customer asks to read. Same rule as the judge prompts.
#   artifacts/reports/ the rendered deliverable — the final scorecard and the
#                      notebook HTML exports. This is the thing the customer is
#                      handed on Thu Aug 13, and until 2026-08-11 it was
#                      ignored, which meant the deliverable existed on one
#                      laptop. Same reasoning as artifacts/replay/: a
#                      deliverable that is not on the remote is not a
#                      deliverable, it is a local file.
#   artifacts/backup/  the adk-demo terminal capture. It is the fallback for
#                      the one workshop segment that cannot run in replay mode,
#                      so if the live demo fails and this file is not on the
#                      remote, that segment has no fallback at all. Recorded
#                      once during rehearsal and never regenerated — a re-record
#                      is a different recording.
#
# artifacts/samples/ stays ignored — review scratch, superseded by the corpus.
artifacts/*
!artifacts/replay/
!artifacts/results/
!artifacts/optimizer/
!artifacts/reports/
!artifacts/backup/

# The rendered public site. `mkdocs build` / `gh-deploy` regenerate it from
# site_src/, and gh-deploy pushes it to the gh-pages branch — a copy on main
# would only ever be stale.
site/
